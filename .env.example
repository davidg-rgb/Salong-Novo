# Salong NOVO — environment template. Copy to .dev.vars (local) / set as Cloudflare
# Pages secrets (prod). NEVER commit real values. The repo's guard hooks block secret files.

# Public site URL — canonical apex (used for canonical, sitemap, schema.org, CSRF origin check)
PUBLIC_SITE_URL="https://salongnovo.se"

# R2 public image base. Stage A (launch): leave EMPTY → images serve same-origin via
# /api/media/*. Set to "https://img.salongnovo.se" only at the Stage-B cutover (ARCHITECTURE §10.7).
PUBLIC_IMAGE_BASE=""

# Voady booking link (public)
PUBLIC_BOOKING_URL="https://bokning.voady.se/novo"

# GA4 (public measurement id) — optional until analytics phase
PUBLIC_GA4_ID=""

# Admin: Cloudflare Access enforces auth at the edge (no app password).
# This shared secret only guards the write API as defense-in-depth.
ADMIN_API_TOKEN=""

# Cloudflare Access JWT verification (PROD ONLY — set in the Pages dashboard,
# never locally). ACCESS_AUD = the Access application's Audience (AUD) tag;
# ACCESS_TEAM_DOMAIN = "<team>.cloudflareaccess.com" (ARCHITECTURE §10.3).
ACCESS_AUD=""
ACCESS_TEAM_DOMAIN=""

# DEV ONLY — set in .dev.vars to simulate the Access identity on localhost (Access
# cannot gate localhost). MUST be absent in prod; assertNoDevBypassInProd() throws
# if it coexists with ACCESS_AUD/ACCESS_TEAM_DOMAIN.
# DEV_ADMIN_EMAIL="info@salongnovo.se"
