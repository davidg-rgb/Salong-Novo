---
import "../styles/tokens.css";
// JS-gated motion only (every rule needs a class refresh.ts adds). Static design lives
// in the components, whose scoped styles load after this and own their elements.
import "../styles/motion.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { type Locale, type PageKey, alternates } from "../i18n";
import { hairSalonJsonLd, ogMeta, siteNoindex } from "../lib/seo";

interface Props {
  title: string;
  description: string;
  locale: Locale;
  pageKey: PageKey;
  image?: string;
  /**
   * hreflang alternates. Defaults to both-locale alternates for `pageKey`.
   * Pass `null` to suppress them on single-language pages (e.g. a blog post,
   * which exists in one locale only — emitting alternates to the other locale's
   * blog index would be a false translation signal).
   */
  alternateLinks?: { locale: Locale; path: string }[] | null;
}
const { title, description, locale, pageKey, image, alternateLinks } = Astro.props;
const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "";
const canonical = siteUrl + Astro.url.pathname;
const alts = alternateLinks === undefined ? alternates(pageKey) : alternateLinks;
const og = ogMeta({ title, description, canonical, locale, image });
// The structured data carries the salon's address and phone number, so this
// layout is an SSR content reader like any other component. The bundle is
// memoized per request — awaiting it here costs nothing extra.
const { kv } = await Astro.locals.getCms();
const jsonld = hairSalonJsonLd(siteUrl, kv);
// Staging builds only. The canonical stays as it is on purpose: a staging copy
// that points at itself is exactly what must not be indexed, and rewriting the
// canonical to production would instead invite a bot to go index production
// from here. The `robots` meta is the honest signal; `noindex` wins over any
// canonical anyway.
const noindex = siteNoindex();
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Motion flag before first paint (2026-10-11), so motion.css's held states are what
        paints first instead of the finished page flashing and then vanishing. ONLY
        nr-motion: html.nr is refresh.ts's idempotency guard and must stay its own. Inline
        is allowed here: the strict `script-src 'self'` CSP covers /admin/* only, which
        does not use this layout. */}
    <script is:inline>if (!matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.classList.add("nr-motion");</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..700;1,400..600&family=Hanken+Grotesk:wght@300..700&display=swap"
    />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {alts && alts.map((a) => (
      <link rel="alternate" hreflang={a.locale} href={siteUrl + a.path} />
    ))}
    {alts && alts[0] && (
      <link rel="alternate" hreflang="x-default" href={siteUrl + alts[0].path} />
    )}
    {Object.entries(og).map(([k, v]) => (
      <meta property={k} content={v} />
    ))}
    <link rel="icon" href="/favicon.ico" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
    <style is:global>
      /* ── Editorial type scale + rhythm (LOCKED 2026-06-01) ──
         Global layer that every page/component inherits. Component-specific
         styling stays scoped in each .astro file. */
      :root {
        --mx: clamp(24px, 6vw, 80px);
        --section: clamp(88px, 13vw, 170px);
        --gutter: clamp(20px, 3vw, 36px);
        /* The refresh's two curves (2026-09-30): a long ease-out for reveals and hovers,
           a symmetric ease for loops. */
        --ease: cubic-bezier(0.22, 1, 0.36, 1);
        --ease-io: cubic-bezier(0.65, 0, 0.35, 1);
      }
      body {
        font-size: clamp(16px, 1.1vw, 18px);
        text-rendering: optimizeLegibility;
        overflow-x: hidden;
      }
      /* Cream on the CTA bronze (2026-09-30): about 5.3:1, where white on the texture
         bronze was about 3.2:1 (both computed from the tokens). */
      ::selection { background: var(--terracotta); color: var(--cream); }
      /* Off-screen until focused, then a solid plate above the sticky header. */
      .skip-link {
        position: absolute; left: 8px; top: -100px; z-index: 200;
        padding: 12px 18px; background: var(--ink); color: var(--snow);
        font-size: 13px; font-weight: 600; letter-spacing: 0.08em;
        transition: top 0.2s ease;
      }
      .skip-link:focus { top: 8px; }
      h1 { font-size: clamp(40px, 8vw, 118px); line-height: 1.0; letter-spacing: -0.02em; }
      h2 { font-size: clamp(28px, 4.4vw, 62px); line-height: 1.04; letter-spacing: -0.02em; }
      h3 { font-size: clamp(18px, 2vw, 24px); line-height: 1.1; letter-spacing: -0.01em; }
      /* A single word longer than the column is the one thing a clamp cannot
         solve, and `body { overflow-x: hidden }` above HIDES it rather than
         fixing it — so the spill is silent. Belt and braces: let a long word
         break, and drop the h1 floor on the narrowest phones, where 40px was
         wider than the measure. Measured at 320px: "Integritetspolicy" set 283px
         into a 272px column, "NOVO-familjen." 277px.
         SCOPED to the narrow phones that need it: applied globally, Chromium's
         `text-wrap: balance` treats break-word's anywhere-breaks as candidates
         and split "Behandlingar & priser" MID-WORD on desktop ("Behandlinga /
         r & priser") to equalise the lines (client round 4, 2026-08-30). No
         heading word approaches its column width above 360px. */
      @media (max-width: 360px) {
        h1, h2, h3 { overflow-wrap: break-word; }
        h1 { font-size: clamp(32px, 10vw, 40px); }
      }
      em { font-style: italic; }
      /* full-bleed page gutter — replaces the scaffold's narrow .wrap padding */
      .wrap { max-width: var(--maxw); margin: 0 auto; padding: 0 var(--mx); }
      /* eyebrow / kicker — editorial label-caps */
      .kicker {
        display: inline-flex; align-items: center; gap: 14px;
        font-family: var(--font-sans); font-size: 11px; font-weight: 600;
        letter-spacing: 0.22em; text-transform: uppercase;
        /* --bronze-dark (6.1:1 on cream) — passes WCAG AA for this 11px bold label.
           --bronze-muted (#8c7352) was ~4.3:1 and failed (review 2026-06-01). */
        color: var(--bronze-dark);
      }
      .kicker::before {
        content: ""; width: 40px; height: 1px; background: var(--bronze);
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#main">{locale === "en" ? "Skip to content" : "Hoppa till innehållet"}</a>
    <SiteHeader locale={locale} pageKey={pageKey} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter locale={locale} />
    {/* The refresh's client layer — bundled and deferred by Astro, on every page. It is a
        no-op wherever its targets (.hero, .strip, .team-grid) are missing. */}
    <script>
      import "../scripts/refresh";
    </script>
  </body>
</html>
