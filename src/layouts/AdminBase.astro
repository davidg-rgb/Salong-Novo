---
/**
 * The admin shell (ARCHITECTURE §6.16, F-016) — used by every `/admin/*` page,
 * never the public `Base.astro`.
 *
 * The write token comes off `Astro.locals` (stamped by the middleware on an
 * admitted admin request), NOT from `bindings()`. That invariant is §8.6's:
 * nothing outside the middleware and the API routes touches a binding, so the
 * layout cannot accidentally become a second place that has to get the
 * Vercel/no-binding path right.
 *
 * The token in a meta tag is defense layer 2. Cloudflare Access is the real gate
 * — a cross-site attacker can neither read this noindex page nor set the
 * `x-admin-token` header without a CORS grant we never issue.
 */
import "../styles/tokens.css";
import "../styles/admin.css";
import AdminNav from "../components/admin/AdminNav.astro";
import { adminString } from "../lib/cms/strings.sv";

interface Props {
  title: string;
}

const { title } = Astro.props;

const adminToken = Astro.locals.adminToken ?? "";
const adminEmail = Astro.locals.adminEmail ?? "";
/** Under the dev identity there is no Access session to log out of. */
const showLogout = !import.meta.env.DEV;
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="admin-token" content={adminToken} />
    <title>{title} — {adminString("admin.title")}</title>
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body class="admin">
    <AdminNav email={adminEmail} showLogout={showLogout} />
    <main id="main" class="admin-main">
      <slot />
    </main>
    <!--
      One toast element per page, owned by whichever client script is wired in.
      It lives in the layout so every admin screen reports success and failure
      the same way, and so a raw error code can never be the thing on screen.
    -->
    <p id="admin-toast" class="admin-toast" role="status" aria-live="polite" hidden></p>
  </body>
</html>
