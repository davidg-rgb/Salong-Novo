---
import { type Locale, useT, localizePath } from "../i18n";
import { asStylist, getStats, stylistBio, stylistPhotoUrl } from "../lib/content";
import { resolveCollection } from "../lib/collections";
import { bindings } from "../lib/cms/bindings";
import { STAFF } from "../cms.config";
import BookingButton from "./BookingButton.astro";
import Logo from "./Logo.astro";
const { locale } = Astro.props as { locale: Locale };
const { kv } = await Astro.locals.getCms();
const t = useT(locale, kv);
const stats = getStats(kv);
// The roster is a collection: the JSON defaults render until the client edits
// the list, and from her first stylist onward the list in D1 is the roster.
const staff = (await resolveCollection(Astro.locals.db, STAFF)).items.map(asStylist);
const staffLabel = t("nav.staff");
const imageBase = (await bindings()).PUBLIC_IMAGE_BASE ?? "";
// Section order is client-confirmed (ARCHITECTURE §2A.2): hero → Boka tid → hair strip →
// founders story → team (hover/focus/tap bios). Pending assets (salon video, owners photo)
// slot into these existing slots without layout changes.

// The strip's five looks — one per competition class NOVO placed in, plus a second
// Nykomling frame, chosen for contrast (light studio ↔ dark neon) as the row scrolls.
// `category` names the class the image competed in; it feeds the alt text.
const gallery = [
  { src: "/images/awards-2026/farg-1.jpg", category: "Årets Färg" },
  { src: "/images/awards-2026/avantgarde-2.jpg", category: "Avantgarde" },
  { src: "/images/awards-2026/nykomling-1.jpg", category: "Årets Nykomling" },
  { src: "/images/awards-2026/herr-3.jpg", category: "Årets Herr" },
  { src: "/images/awards-2026/nykomling-3.jpg", category: "Årets Nykomling" },
];
---
<!-- 1 ── HERO. Dark editorial plate (approved mockup novo-editorial-v1-b): a full-bleed
     photograph carries the first screen, headline in cream over it. The brand hair texture is
     the standing image; a muted, looped salon-ambience video drops in behind .hero-inner later
     (gated on prefers-reduced-motion + Save-Data), at which point the texture becomes the
     no-JS / reduced-motion fallback rather than the subject. -->
<section class="hero">
  <div class="hero-soft" aria-hidden="true"></div>
  <div class="wrap hero-inner">
    <p class="kicker">{t("home.kicker")}</p>
    {/* The brand itself is the headline (client round 2, 2026-08-25). The mark is
        decorative, so the <h1> carries the word for screen readers and the document
        outline; the line that used to be the h1 is now the tagline under it, still
        rendered from `home.heading` so the client can still edit it. */}
    <h1 class="hero-brand"><Logo tone="white" decorative /><span class="hero-brand-text">NOVO</span></h1>
    <p class="hero-tagline">{t("home.heading")}</p>
    <p class="sub">{t("home.sub")}</p>
    <div class="cta">
      <BookingButton locale={locale} />
      <a class="btn btn--ghost" href={localizePath("staff", locale)}>{t("cta.meetTeam")}</a>
    </div>
  </div>
</section>

<!-- 2 ── HAIR-GALLERY STRIP. "Sedan kan de rulla lite fina hårbilder i en rad." Horizontal
     scroll-snap row. The real Årets Frisör 2026 photography landed 2026-08-12, so the
     placeholder tiles are gone and the strip is what the review of 2026-06-01 said it should
     become once captioned photos existed: a named region, each tile a described image. -->
<section class="strip" aria-label={t("home.galleryLabel")}>
  <ul class="strip-track" role="list">
    {gallery.map((shot, i) => (
      <li class="tile" style={`--i:${i}`}>
        <img
          src={shot.src}
          alt={t("home.galleryAlt", { category: shot.category })}
          loading="lazy"
          decoding="async"
        />
        {/* The class name is already in the alt text above, so the caption is
            aria-hidden: it names the frame for sighted readers without making a
            screen reader announce the same words twice per tile. */}
        <span class="cap" aria-hidden="true">{shot.category}</span>
      </li>
    ))}
  </ul>
</section>

<!-- 3 ── FOUNDERS STORY. "Bild på mig och Chriss och en story om oss och salongen." -->
<section class="story">
  <div class="wrap story-grid">
    <div class="story-media" aria-hidden="true"><span class="story-frame"><span class="mono">N</span></span></div>
    <div class="story-copy">
      <p class="kicker">{t("nav.about")}</p>
      <h2>{t("about.heading")}</h2>
      <p>{t("about.body1")}</p>
      <a class="story-more" href={localizePath("about", locale)}>{t("cta.readStory")} <span class="arr">→</span></a>
      <ul class="story-stats" role="list">
        <li><b><span class="u">×</span>{stats.arets_kollektion_wins}</b><span>{t("home.statCollection")}</span></li>
        <li><b>{stats.stylists}</b><span>{staffLabel}</span></li>
        <li><b>{stats.founded}</b><span>Est.</span></li>
      </ul>
    </div>
  </div>
</section>

<!-- 4 ── TEAM. "Vårat fantastiska team med bilder" + "när man drar pilen över varje bild … en kort
     text om just den frisören." Bio reveals on hover (mouse), focus (keyboard), and first tap
     (touch — via the script below toggling .is-revealed). The text is always in the DOM. Pending
     stylist texts fall back to name + role. -->
<section class="team">
  <div class="wrap">
    <div class="team-head">
      <p class="kicker">{staffLabel}</p>
      <h2>{t("home.teamHeading")}</h2>
      <a class="team-all" href={localizePath("staff", locale)}>{t("cta.allTeam")} <span class="arr">→</span></a>
    </div>
    <ul class="team-grid" role="list">
      {staff.map((s, i) => {
        const bio = stylistBio(s, locale);
        const role = s.specialty !== "TODO" ? s.specialty : s.role;
        const photo = stylistPhotoUrl(s.photo, imageBase);
        return (
          <li>
            <a class="team-card" href={localizePath("staff", locale)} aria-label={`${s.name} — ${role}`}>
              {/* First row eager (see StaffGrid for the reasoning); rows 2+ lazy. */}
              <span class="frame" aria-hidden="true">
                {photo
                  ? <img
                      class="portrait"
                      src={photo}
                      alt={s.name}
                      width="600"
                      height="800"
                      loading={i < 4 ? "eager" : "lazy"}
                      fetchpriority={i < 4 ? "high" : undefined}
                      decoding="async"
                    />
                  : <span class="mono">{s.name.charAt(0)}</span>}
                <span class="duo"></span>
                {bio && <span class="bio"><span class="bio-inner">{bio}</span></span>}
              </span>
              <b>{s.name}</b>
              <span class="role">{role}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<!-- The texture band that used to close the page is gone (2026-08-25): the hero now carries
     hair-band.jpg, so a second full-bleed copy of the same texture 4 sections later read as a
     repeat, and the champagne closing band already makes the tonal hand-off into the black
     footer on its own. -->

<style>
  /* ── 1. Hero — dark editorial plate (approved mockup novo-editorial-v1-b). `padding: 0`
     is deliberate: the global `section` rule in tokens.css adds clamp(88px, 13vw, 170px),
     which stacked on top of .hero-inner's own inset inside an already 82vh-tall box. */
  .hero {
    position: relative; overflow: hidden; padding: 0;
    min-height: clamp(520px, 82vh, 860px);
    display: flex; flex-direction: column; justify-content: flex-end;
    background: #0a0e11;
  }
  /* The scrim is what makes the headline legible over the photograph, so it ramps
     downward — lightest at the top where the header sits, near-opaque at the baseline
     where the copy lands. Solid #0a0e11 stays the paint-order fallback. */
  .hero-soft {
    position: absolute; inset: 0;
    background:
      linear-gradient(180deg, rgba(10, 14, 17, 0.45) 0%, rgba(10, 14, 17, 0.72) 55%, rgba(10, 14, 17, 0.93) 100%),
      url("/images/textures/hair-band.jpg") center / cover no-repeat,
      #0a0e11;
  }
  .hero-inner { position: relative; z-index: 2; padding-top: clamp(72px, 12vh, 140px); padding-bottom: clamp(48px, 8vh, 96px); }
  /* The wordmark IS the headline now, so the faint 10%-opacity watermark that used to
     sit behind the copy is gone — the brand cannot appear twice on one screen. The mark
     is near-square (viewBox 758×707), so it is capped on viewport HEIGHT as well as
     width: 70vw on a landscape phone would otherwise be taller than the hero itself. */
  .hero-brand { margin: clamp(16px, 2.4vh, 30px) 0 clamp(14px, 2vh, 24px); line-height: 0; }
  .hero-brand :global(.novo-logo) { display: block; }
  .hero-brand :global(.novo-logo svg) { width: min(70vw, 540px, 48vh); height: auto; }
  /* Names the mark in the a11y tree and the outline; the SVG beside it is aria-hidden. */
  .hero-brand-text {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
  /* 22ch + balance: `home.heading` is client-editable (cms.config.ts), and a ragged
     three-line break reads far worse over a photograph than over flat cream. */
  .hero-tagline {
    font-family: var(--font-serif); font-weight: 400; line-height: 1.2; letter-spacing: -0.01em;
    font-size: clamp(20px, 2.2vw, 30px); color: var(--cream);
    max-width: 22ch; text-wrap: balance; margin-bottom: 22px;
  }
  .hero .sub { max-width: 48ch; color: rgba(248, 248, 248, 0.72); margin-bottom: 32px; line-height: 1.55; }
  .cta { display: flex; gap: 16px; flex-wrap: wrap; }
  /* Dark-surface overrides for the two globals that assume a light page. --bronze-dark is
     6.1:1 on cream but ~2.4:1 on #0a0e11, and .btn--ghost is ink-on-transparent, i.e.
     invisible here. Champagne and cream restore both to AA on this plate. */
  .hero .kicker { color: var(--champagne); }
  .hero .kicker::before { background: var(--champagne); }
  .hero .btn--ghost { color: var(--cream); border-color: rgba(248, 248, 248, 0.5); }
  .hero .btn--ghost:hover { background: var(--cream); color: var(--ink); border-color: var(--cream); }

  /* ── 2. Hair strip — horizontal scroll-snap row of captioned award frames. `padding: 0`
     drops the global `section` inset, which was putting up to 170px of white above AND
     below the row INSIDE its own hairlines; the band now runs edge to edge. */
  .strip { padding: 0; border-top: 1px solid var(--hairline); border-bottom: 1px solid var(--hairline); background: var(--white); }
  .strip-track {
    list-style: none; display: flex; gap: 1px; overflow-x: auto; scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch; scrollbar-width: none;
  }
  .strip-track::-webkit-scrollbar { display: none; }
  .tile {
    flex: 0 0 clamp(220px, 26vw, 340px); aspect-ratio: 4/5; scroll-snap-align: start;
    background: linear-gradient(150deg, #34302a, #1d1c19);
    position: relative; isolation: isolate;
  }
  /* Desaturating the photograph is what unifies the row, not a tint. The old bronze wash
     ramped 0.16 → 0.28 across the five tiles, so they read as five differently-tinted
     pictures — and on the three white-seamless studio shots a `mix-blend-mode: color`
     bronze turned clean white backgrounds tan. The wash stays, flat and faint, as warmth.
     `--i` is still set on each <li> for the next thing that wants a per-tile ramp. */
  .tile img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: grayscale(0.9) contrast(1.05); }
  .tile::after {
    content: ""; position: absolute; inset: 0;
    background: var(--bronze); mix-blend-mode: color; opacity: 0.1;
  }
  /* Caption — .tile is `isolation: isolate` and .tile::after has no z-index, so the
     caption needs one to sit above the wash. */
  .tile .cap {
    position: absolute; left: 0; right: 0; bottom: 0; z-index: 1;
    padding: 26px 16px 14px;
    font-size: 10.5px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--cream);
    background: linear-gradient(to top, rgba(10, 14, 17, 0.85), transparent);
  }

  /* ── 3. Founders story — media + copy, hairline-gridded stat trio. */
  .story { padding: var(--section) 0; }
  .story-grid { display: grid; grid-template-columns: 0.85fr 1fr; gap: clamp(28px, 5vw, 72px); align-items: center; }
  /* Standing in for the owners photo the client still owes us. Backed by a real brand
     texture rather than a flat gradient so the slot reads as art direction instead of a
     missing image — the monogram drops back to a watermark over it. Swap the background
     for the photograph when it lands; the geometry does not change. */
  .story-frame {
    display: grid; place-items: center; aspect-ratio: 4/5; width: 100%;
    background:
      linear-gradient(rgba(10, 14, 17, 0.55), rgba(10, 14, 17, 0.55)),
      url("/images/textures/silk-band.jpg") center / cover no-repeat,
      #1c1b18;
    position: relative; overflow: hidden;
  }
  .story-frame .mono { font-family: var(--font-serif); font-size: clamp(70px, 9vw, 140px); color: rgba(255,255,255,0.28); }
  .story-copy h2 { font-weight: 400; margin: 14px 0 22px; max-width: 16ch; }
  .story-copy p { color: var(--ink); line-height: 1.65; max-width: 54ch; margin-bottom: 22px; }
  .story-more { display: inline-flex; align-items: center; gap: 8px; color: var(--bronze-dark); font-weight: 500; }
  .story-more .arr { transition: transform 0.35s; }
  .story-more:hover .arr { transform: translateX(5px); }
  .story-stats { list-style: none; display: flex; gap: clamp(24px, 4vw, 56px); margin-top: clamp(30px, 4vw, 48px); }
  .story-stats b { font-family: var(--font-serif); font-size: clamp(32px, 4vw, 48px); line-height: 1; display: block; color: var(--ink); }
  .story-stats b .u { font-size: 0.42em; color: var(--bronze); vertical-align: super; margin-right: 2px; }
  .story-stats span { display: block; margin-top: 10px; font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--on-variant); }

  /* ── 4. Team — editorial cards with hover/focus/tap bio reveal. */
  .team { padding: 0 0 var(--section); }
  .team-head { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; flex-wrap: wrap; margin-bottom: clamp(26px, 3vw, 44px); }
  .team-head h2 { font-weight: 400; flex: 1 1 auto; }
  .team-all { color: var(--bronze-dark); font-weight: 500; display: inline-flex; align-items: center; gap: 8px; white-space: nowrap; }
  .team-all .arr { transition: transform 0.35s; }
  .team-all:hover .arr { transform: translateX(5px); }
  .team-grid { list-style: none; display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--gutter, 1.5rem) clamp(14px, 2vw, 28px); }
  .team-card { display: flex; flex-direction: column; color: inherit; }
  .team-card .frame {
    position: relative; aspect-ratio: 3/4; overflow: hidden; isolation: isolate;
    background: linear-gradient(160deg, #33302a, #1c1b18); display: grid; place-items: center;
  }
  /* Clay plate + dead-paint kill for photo cards — same reasoning as StaffGrid. */
  .team-card .frame:has(.portrait) { background: var(--clay); }
  .team-card .frame:has(.portrait) .duo { opacity: 0; }
  .team-card .mono { font-family: var(--font-serif); font-size: clamp(40px, 5vw, 72px); color: rgba(255,255,255,0.92); }
  /* Portrait under .duo and under .bio: black-and-white at rest, true colour on
     reveal — matches the team page (client re-theme 2026-08-25). :focus-within
     is listed alongside :focus-visible so the portrait un-greys on exactly the
     same trigger that reveals .bio below. */
  .team-card .portrait { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: grayscale(1); transition: filter 0.55s ease; }
  .team-card .duo { position: absolute; inset: 0; background: var(--charcoal); mix-blend-mode: color; opacity: 0.32; transition: opacity 0.55s ease; }
  .team-card:hover .portrait, .team-card:focus-within .portrait, .team-card:focus-visible .portrait, .team-card.is-revealed .portrait { filter: grayscale(0); }
  .team-card:hover .duo, .team-card:focus-within .duo, .team-card:focus-visible .duo { opacity: 0; }
  /* Bio overlay — always in the DOM; revealed on hover, keyboard focus, and tap (.is-revealed). */
  .team-card .bio {
    position: absolute; inset: 0; display: flex; align-items: flex-end;
    padding: 16px; background: linear-gradient(to top, rgba(10,10,10,0.82), rgba(10,10,10,0.1));
    opacity: 0; transition: opacity 0.4s ease;
  }
  /* Reveal on hover (mouse), focus (keyboard), and .is-revealed (first tap on touch — see script). */
  .team-card:hover .bio,
  .team-card:focus-within .bio,
  .team-card:focus-visible .bio,
  .team-card.is-revealed .bio { opacity: 1; }
  .team-card.is-revealed .duo { opacity: 0; }
  .bio-inner { color: #f3ede3; font-size: 12.5px; line-height: 1.5; }
  .team-card b { font-family: var(--font-serif); font-weight: 500; font-size: 18px; margin-top: 15px; color: var(--ink); }
  .team-card .role { font-size: 10.5px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--on-variant); margin-top: 5px; }

  @media (max-width: 1000px) { .team-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 820px) {
    .story-grid { grid-template-columns: 1fr; }
    .story-media { max-width: 420px; }
  }
  @media (max-width: 620px) { .team-grid { grid-template-columns: repeat(2, 1fr); } }

  @media (prefers-reduced-motion: reduce) {
    .tile::after, .team-card .duo, .team-card .bio, .story-more .arr, .team-all .arr { transition: none; }
  }
</style>

<script>
  /* Touch parity for the team bio reveal (§2A.2 / review 2026-06-01). On devices with no hover,
     the first tap on a card that HAS a bio reveals it (instead of navigating); a second tap follows
     the link to the full team page. Cards without a bio navigate on the first tap as normal.
     Mouse/keyboard are untouched (handled by :hover / :focus-within in CSS). */
  if (window.matchMedia("(hover: none)").matches) {
    const cards = Array.from(document.querySelectorAll(".team-card"));
    cards.forEach((card) => {
      card.addEventListener("click", (e) => {
        const hasBio = card.querySelector(".bio");
        if (hasBio && !card.classList.contains("is-revealed")) {
          e.preventDefault();
          cards.forEach((c) => { if (c !== card) c.classList.remove("is-revealed"); });
          card.classList.add("is-revealed");
        }
      });
    });
  }
</script>
