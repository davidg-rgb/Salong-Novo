---
/**
 * Editor form shell (§10.6). A thin presentation layer: every interactive bit is
 * driven by `editor.client.ts`, which reads the serialized draft from the
 * `<script type="application/json" id="draft-data">` block below (no second fetch
 * on edit).
 *
 * Layout since 2026-10-10 (the owner asked for "Google Docs", not Markdown next
 * to a preview): one document column — a borderless serif title, the slug chip,
 * then a white sheet with a sticky toolbar where the body is edited in place
 * (Tiptap, mounted into `[data-rich-surface]`). The `.md-body` textarea is the
 * secondary Markdown-source mode and the no-JS fallback: it starts visible and
 * the client hides it once the document has mounted. Storage stays Markdown.
 *
 * The rail puts the ACTIONS first (above the fold), the Docs-style save status
 * under them, then cover, language, excerpt and SEO. Below 1100px the action
 * block sticks to the viewport bottom (see admin-blog.css).
 */
import type { PostDraft } from "../../lib/editor";
import { ADMIN } from "../../lib/admin-strings";
import EditorToolbar from "./EditorToolbar.astro";
import CoverPicker from "./CoverPicker.astro";
import ImagePicker from "./ImagePicker.astro";

interface Props {
  draft: PostDraft;
  mode: "create" | "edit";
  imageBase: string;
}
const { draft, mode, imageBase } = Astro.props;

const isPublished = draft.status === "published";
// Slug chip path prefix mirrors the public blog route for the draft's locale.
const slugPrefix = draft.locale === "en" ? "/en/blog/" : "/blogg/";
---
<form class="editor" data-editor data-mode={mode} novalidate>
  <!-- Initial draft model — read once by editor.client.ts (no edit-load fetch). -->
  <script type="application/json" id="draft-data" set:html={JSON.stringify(draft)} />

  <div class="editor__main">
    <div class="doc-head">
      <label class="sr-only" for="ed-title">{ADMIN.editor.title}</label>
      <input
        id="ed-title"
        type="text"
        class="doc-title"
        data-field="title"
        value={draft.title}
        placeholder={ADMIN.editor.title}
        autocomplete="off"
      />

      <div class="slug-chip" data-slug-chip>
        <span class="slug-chip__prefix" data-slug-prefix>{slugPrefix}</span>
        <span class="slug-chip__slug" data-slug-display>{draft.slug}</span>
        <input
          type="text"
          class="slug-chip__input"
          data-slug-input
          value={draft.slug}
          hidden
          aria-label={ADMIN.editor.slug}
        />
        <button type="button" class="slug-chip__toggle" data-slug-toggle>
          {draft.slugManual ? ADMIN.editor.slugAuto : ADMIN.editor.slugEdit}
        </button>
      </div>
    </div>

    <div class="sheet" data-sheet>
      <EditorToolbar />
      <div class="sheet__surface" id="ed-body" data-rich-surface aria-label={ADMIN.editor.bodyLabel} hidden></div>
      <textarea
        id="md-body"
        class="md-body"
        data-field="body"
        aria-label={ADMIN.editor.bodyLabel}
        placeholder={ADMIN.editor.bodyPlaceholder}
        spellcheck="true"
      >{draft.body}</textarea>
    </div>
  </div>

  <div class="editor__rail">
    <div class="editor__actions" data-actions>
      <div class="action-bar">
        {isPublished ? (
          <>
            <button type="button" class="btn-primary" data-action="save">{ADMIN.editor.saveChanges}</button>
            <button type="button" class="btn-ghost" data-action="unpublish">{ADMIN.editor.unpublish}</button>
          </>
        ) : (
          <>
            <button type="button" class="btn-ghost" data-action="save">{ADMIN.editor.saveDraft}</button>
            <button type="button" class="btn-primary" data-action="publish">{ADMIN.editor.publish}</button>
          </>
        )}
        <button type="button" class="btn-ghost" data-action="preview">{ADMIN.editor.preview}</button>
        <button type="button" class="btn-danger-ghost" data-action="delete">{ADMIN.editor.delete}</button>
      </div>
      <p class="save-status" data-save-status role="status" aria-live="polite"></p>
      <div class="validation-summary" data-validation role="alert" hidden></div>
    </div>

    <aside class="editor__side" aria-label={ADMIN.editor.sidePanel}>
      <CoverPicker coverImage={draft.coverImage} imageBase={imageBase} />

      <div class="field field--inline">
        <span class="field__label" id="ed-locale-label">{ADMIN.editor.locale}</span>
        <div class="segmented" role="group" aria-labelledby="ed-locale-label" data-field="locale">
          <button type="button" class={`seg ${draft.locale === "sv" ? "seg--on" : ""}`} data-value="sv" aria-pressed={draft.locale === "sv"}>{ADMIN.editor.localeSv}</button>
          <button type="button" class={`seg ${draft.locale === "en" ? "seg--on" : ""}`} data-value="en" aria-pressed={draft.locale === "en"}>{ADMIN.editor.localeEn}</button>
        </div>
      </div>

      <div class="field field--excerpt">
        <div class="field__row">
          <label class="field__label" for="ed-excerpt">{ADMIN.editor.excerpt}</label>
          <span class="counter" data-counter="excerpt" aria-live="polite"></span>
          <button type="button" class="link-btn" data-excerpt-suggest>{ADMIN.editor.excerptSuggest}</button>
        </div>
        <textarea
          id="ed-excerpt"
          class="field__input field__textarea field__textarea--sm"
          data-field="excerpt"
          rows="3"
          maxlength="400"
        >{draft.excerpt}</textarea>
      </div>

      <div class="field">
        <div class="field__row">
          <label class="field__label" for="ed-seo-title">{ADMIN.editor.seoTitle}</label>
          <span class="counter" data-counter="seoTitle" aria-live="polite"></span>
        </div>
        <input
          id="ed-seo-title"
          type="text"
          class="field__input"
          data-field="seoTitle"
          value={draft.seoTitle}
          placeholder={draft.title || ADMIN.editor.title}
          autocomplete="off"
        />
      </div>

      <div class="field">
        <div class="field__row">
          <label class="field__label" for="ed-seo-desc">{ADMIN.editor.seoDesc}</label>
          <span class="counter" data-counter="seoDesc" aria-live="polite"></span>
        </div>
        <textarea
          id="ed-seo-desc"
          class="field__input field__textarea field__textarea--sm"
          data-field="seoDesc"
          rows="3"
        >{draft.seoDesc}</textarea>
      </div>
    </aside>
  </div>

  <dialog class="link-dialog" data-link-dialog aria-labelledby="link-dialog-title">
    <div class="link-dialog__inner">
      <h2 id="link-dialog-title">{ADMIN.editor.linkTitle}</h2>
      <div class="field">
        <label class="field__label" for="link-url">{ADMIN.editor.linkUrl}</label>
        <input id="link-url" type="url" class="field__input" data-link-url placeholder="https://" autocomplete="off" />
      </div>
      <div class="field">
        <label class="field__label" for="link-text">{ADMIN.editor.linkText}</label>
        <input id="link-text" type="text" class="field__input" data-link-text autocomplete="off" />
      </div>
      <p class="field__error" data-link-error role="alert" hidden></p>
      <div class="link-dialog__actions">
        <button type="button" class="btn-danger-ghost link-dialog__remove" data-link-remove hidden>{ADMIN.editor.linkRemove}</button>
        <button type="button" class="btn-ghost" data-link-cancel>{ADMIN.editor.linkCancel}</button>
        <button type="button" class="btn-primary" data-link-apply>{ADMIN.editor.linkApply}</button>
      </div>
    </div>
  </dialog>

  <div class="toast" data-toast role="status" aria-live="polite" hidden></div>

  <!--
    ImagePicker LAST, always (2026-10-10): its <dialog> wraps a nested
    <form method="dialog">. Browsers ignore the nested start tag but honour its
    </form>, which closes THIS form — anything after it falls outside `form` and
    `form.querySelector` returns null (the toast was silently dead this way).
  -->
  <ImagePicker imageBase={imageBase} />
</form>
