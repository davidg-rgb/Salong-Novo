---
/**
 * The generic collection manager (ARCHITECTURE §5, §6.16, §9.9, F-010).
 *
 * Everything on screen comes from the `CollectionDef`: the label, the fields,
 * whether the list can be reordered. Adding a list to this site adds nothing
 * here — that is the config-driven model paying out (§12).
 *
 * Reordering reuses `wireReorder` unchanged. The endpoint is the collection's
 * own POST, which discriminates a `{ids}` body from a create; no `data-category`
 * is set because a collection is not sliced the way the portfolio is.
 *
 * THE EMPTY STATE IS TWO STATES. This project does not seed (see
 * `src/lib/collections.ts`), so an empty table usually means "the JSON defaults
 * are still on the page", not "the page is blank" — and the difference decides
 * what the client should do next. With defaults behind it the empty state says
 * so and offers to copy them in; without them it is the plain "add the first
 * one" text the core ships.
 */
import CollectionItemForm from "./CollectionItemForm.astro";
import { adminString } from "../../lib/cms/strings.sv";
import type { CollectionDef, CollectionItem } from "../../lib/cms/config-types";

interface Props {
  def: CollectionDef;
  items: CollectionItem[];
}

const { def, items } = Astro.props;

/** The first non-empty text value on the row — the heading for its editor. */
function summarize(item: CollectionItem): string {
  for (const field of def.fields) {
    for (const prop of field.bilingual ? [`${field.name}_sv`, `${field.name}_en`] : [field.name]) {
      const value = item.data[prop];
      if (typeof value === "string" && value.trim() !== "") return value;
    }
  }
  return `#${item.id}`;
}

/** How many rows the public page is rendering from JSON right now. */
const defaultCount = items.length === 0 ? def.jsonFallback().length : 0;

/** `{n}` filled the way `media.client.ts` fills `{usage}` — one token, one call site. */
const withCount = (key: string): string =>
  adminString(key).replace("{n}", String(defaultCount));
---

{
  items.length === 0 ? (
    defaultCount > 0 ? (
      <div class="admin-empty">
        <p>{withCount("collection.fallbackNotice")}</p>
        <button
          class="admin-btn"
          type="button"
          data-seed-endpoint={`/api/admin/collections/${def.name}`}
        >
          {withCount("collection.copyDefaults")}
        </button>
      </div>
    ) : (
      <p class="admin-empty">{adminString("collection.empty")}</p>
    )
  ) : (
    <>
      {def.orderable && <p class="admin-field__hint">{adminString("collection.reorderHint")}</p>}
      <ul
        class="collection-list"
        data-reorder-endpoint={def.orderable ? `/api/admin/collections/${def.name}` : undefined}
      >
        {items.map((item) => (
          <li class="collection-item" data-reorder-item data-id={item.id}>
            <div class="collection-item__head">
              {def.orderable && (
                <div class="collection-item__handles">
                  <button
                    class="admin-btn admin-btn--ghost admin-btn--sm"
                    type="button"
                    data-move-up
                    aria-label={`${adminString("collection.moveUp")}: ${summarize(item)}`}
                  >
                    ▲
                  </button>
                  <button
                    class="admin-btn admin-btn--ghost admin-btn--sm"
                    type="button"
                    data-move-down
                    aria-label={`${adminString("collection.moveDown")}: ${summarize(item)}`}
                  >
                    ▼
                  </button>
                </div>
              )}
              <p class="collection-item__title">{summarize(item)}</p>
            </div>

            <CollectionItemForm def={def} item={item} />
          </li>
        ))}
      </ul>
    </>
  )
}

<section class="admin-panel collection-add">
  <h2 class="admin-panel__title">{adminString("collection.addTitle")}</h2>
  <CollectionItemForm def={def} item={null} />
</section>

<script>
  import { wireReorderLists } from "../../admin/reorder.client";
  import { wireCollectionManager } from "../../admin/forms.client";
  wireReorderLists();
  wireCollectionManager();
</script>
