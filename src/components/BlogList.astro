---
import { type Locale, t, localizePath } from "../i18n";
import type { Post } from "../lib/posts";
const { locale, posts } = Astro.props as { locale: Locale; posts: Post[] };
const blogBase = localizePath("blog", locale);
---
<section class="blog wrap">
  <header class="shead">
    <p class="kicker">{t(locale, "blog.title")}</p>
    <h1>{t(locale, "blog.title")}</h1>
    <p class="intro">{t(locale, "blog.intro")}</p>
  </header>
  {posts.length === 0 ? (
    <p class="empty">{t(locale, "blog.empty")}</p>
  ) : (
    <ul class="post-list" role="list">
      {posts.map((p) => (
        <li>
          <a href={`${blogBase}/${p.slug}`}>
            <span class="date">{p.publishedAt?.slice(0, 10)}</span>
            <h2>{p.title}</h2>
            <p>{p.excerpt}</p>
            <span class="more">{t(locale, "cta.readMore")} <span class="arr">→</span></span>
          </a>
        </li>
      ))}
    </ul>
  )}
</section>

<style>
  .blog { max-width: 940px; padding: var(--section) 0; }
  .shead { margin-bottom: clamp(38px, 5vw, 68px); }
  .blog h1 { margin: 18px 0 16px; }
  .intro { color: var(--on-variant); max-width: 60ch; font-size: clamp(16px, 1.5vw, 19px); }
  .post-list { list-style: none; display: grid; gap: 0; border-top: 1px solid var(--hairline); }
  .post-list li a {
    display: block; padding: clamp(28px, 3.5vw, 44px) 0; border-bottom: 1px solid var(--hairline);
    transition: padding-left 0.4s, background 0.4s;
  }
  .post-list li a:hover { padding-left: 16px; background: var(--cream); }
  .date { font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--bronze-muted); }
  .post-list h2 { font-size: clamp(24px, 3vw, 36px); margin: 12px 0; }
  .post-list p { color: var(--on-variant); max-width: 70ch; }
  .more { display: inline-flex; align-items: center; gap: 8px; margin-top: 14px; font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--bronze-muted); }
  .post-list li a:hover .more .arr { transform: translateX(5px); }
  .more .arr { transition: transform 0.35s; }
  .empty { color: var(--on-variant); }
</style>
