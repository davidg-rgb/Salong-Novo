---
import { type Locale, t } from "../i18n";
import { getSite } from "../lib/content";
import { contact } from "../lib/pagecopy";
import BookingButton from "./BookingButton.astro";
const { locale } = Astro.props as { locale: Locale };
const site = getSite();
const mapQuery = encodeURIComponent(`${site.address.street}, ${site.address.postal} ${site.address.city}`);
---
<section class="contact wrap">
  <div class="info">
    <p class="kicker">N° 01 — {t(locale, "nav.contact")}</p>
    <h1>{contact.heading[locale]}</h1>
    <address>
      {site.address.street}<br />
      {site.address.postal} {site.address.city}<br />
      <span class="muted">T-bana {site.transit.metro}</span>
    </address>
    <p class="dir">{contact.directions[locale]}</p>
    <ul class="reach">
      <li><a href={`tel:${site.phone.replace(/\s/g, "")}`}>{site.phone_display}</a></li>
      <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
      <li><a href={site.instagram} target="_blank" rel="noopener">{site.instagram_handle}</a></li>
    </ul>
    <BookingButton locale={locale} />
    <p class="cancel muted">{contact.cancellation[locale]}</p>
  </div>
  <div class="map">
    <iframe
      title="Karta till Salong NOVO"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      src={`https://maps.google.com/maps?q=${mapQuery}&z=16&output=embed`}
    ></iframe>
  </div>
</section>

<style>
  .contact { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(34px, 4vw, 60px); padding: var(--section) 0; align-items: start; }
  .info h1 { margin: 18px 0 clamp(28px, 4vw, 44px); }
  address { font-style: normal; line-height: 1.8; font-size: clamp(16px, 1.4vw, 18px); color: var(--ink); margin-bottom: 1.6rem; }
  .dir { color: var(--on-variant); margin-bottom: 1.8rem; max-width: 48ch; line-height: 1.65; }
  .reach { list-style: none; margin-bottom: 1.8rem; line-height: 2; }
  .reach a { color: var(--ink); transition: color 0.3s; }
  .reach a:hover { color: var(--bronze-dark); }
  .cancel { font-size: 13px; margin-top: 1.6rem; max-width: 50ch; line-height: 1.6; }
  .muted { color: var(--on-variant); }
  .map { aspect-ratio: 4/5; min-height: 340px; }
  .map iframe { width: 100%; height: 100%; min-height: 340px; border: 1px solid var(--hairline); filter: grayscale(0.4) contrast(0.96); }
  @media (max-width: 820px) { .contact { grid-template-columns: 1fr; } .map { aspect-ratio: auto; } }
</style>
