---
import { type Locale, useT } from "../i18n";
import StaffGrid from "./StaffGrid.astro";
const { locale } = Astro.props as { locale: Locale };
const { kv } = await Astro.locals.getCms();
const t = useT(locale, kv);
---
<section class="wrap staff-page">
  <header class="shead">
    <p class="kicker">N° 02 — {t("nav.staff")}</p>
    <h1>{t("nav.staff")}</h1>
    <p class="intro">{t("staff.intro")}</p>
  </header>
  <StaffGrid locale={locale} />
</section>
<style>
  .staff-page { padding-block: var(--section); }  /* padding-block only: the element is also .wrap, which owns the side gutters */
  .shead { margin-bottom: clamp(38px, 5vw, 68px); }
  .staff-page h1 { margin: 18px 0 16px; text-wrap: balance; }
  .intro { color: var(--on-variant); max-width: 52ch; font-size: clamp(16px, 1.5vw, 19px); }
</style>
