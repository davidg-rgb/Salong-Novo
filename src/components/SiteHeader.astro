---
import {
  type Locale,
  type PageKey,
  useT,
  localizePath,
  LOCALES,
} from "../i18n";
import BookingButton from "./BookingButton.astro";
import Logo from "./Logo.astro";

interface Props { locale: Locale; pageKey: PageKey; }
const { locale, pageKey } = Astro.props;
const { kv } = await Astro.locals.getCms();
const t = useT(locale, kv);

// Primary nav = the client-confirmed tabs, in client order (ARCHITECTURE §2A.1), plus
// BLOGG, promoted out of the footer on client request (round 2, 2026-08-25). The blog
// stays in the footer too. `about` is still footer-only. BUTIK (the Keune product wall,
// 2026-09-29) sits right after Våra brands, the page that introduces the brand.
const navKeys: PageKey[] = ["contact", "staff", "pricing", "competitions", "education", "brands", "shop", "blog", "work"];
const otherLocale = LOCALES.find((l) => l !== locale)!;
---
<header class="site-header">
  <div class="wrap header-inner">
    <a href={localizePath("home", locale)} class="logo" aria-label="Salong NOVO">
      {/* Client round 3 (2026-08-27): "NOVO luggen uppe i rubriken kan vara lite
          större — på webvarianten ser den lite liten ut i jämförelse med
          mobilvarianten." A fixed 32px was the same mark on a 375px bar and a
          1152px one, so it only LOOKED small on the wide one. The clamp holds
          mobile at 32px and grows it to 46px on desktop, inside the 74px bar. */}
      <Logo tone="black" height="clamp(32px, 3.2vw, 46px)" decorative />
    </a>
    <nav class="nav-desktop" aria-label="Huvudmeny">
      <ul>
        {navKeys.map((key) => (
          <li>
            <a
              href={localizePath(key, locale)}
              aria-current={key === pageKey ? "page" : undefined}
            >{t(`nav.${key}`)}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="header-right">
      <a class="lang" href={localizePath(pageKey, otherLocale)} hreflang={otherLocale} aria-label={`Switch language to ${otherLocale.toUpperCase()}`}>
        <span class="lang-current">{locale.toUpperCase()}</span>
        <span class="lang-sep">/</span>
        <span class="lang-other">{otherLocale.toUpperCase()}</span>
      </a>
      <BookingButton locale={locale} />
      <button
        type="button"
        class="nav-toggle"
        data-nav-toggle
        aria-controls="mobile-nav"
        aria-expanded="false"
        aria-label={t("labels.menu")}
        data-label-open={t("labels.menu")}
        data-label-close={t("labels.close")}
      >
        <span class="nav-toggle-bars" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="nav-mobile" aria-label="Huvudmeny" data-mobile-nav hidden>
    <ul>
      {navKeys.map((key) => (
        <li>
          <a
            href={localizePath(key, locale)}
            aria-current={key === pageKey ? "page" : undefined}
          >{t(`nav.${key}`)}</a>
        </li>
      ))}
    </ul>
    <div class="nav-mobile-foot">
      <a class="lang" href={localizePath(pageKey, otherLocale)} hreflang={otherLocale} aria-label={`Switch language to ${otherLocale.toUpperCase()}`}>
        <span class="lang-current">{locale.toUpperCase()}</span>
        <span class="lang-sep">/</span>
        <span class="lang-other">{otherLocale.toUpperCase()}</span>
      </a>
      <BookingButton locale={locale} />
    </div>
  </nav>
</header>

<script>
  // Accessible mobile menu toggle (vanilla, ~20 lines). Hamburger ↔ panel with
  // aria-expanded, label swap (Meny/Stäng), Esc-to-close, close-on-link, and a
  // body scroll-lock while open. Desktop (≥1341px) ignores all of this.
  // refresh.ts watches aria-expanded to pause smooth scrolling while it is open.
  const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const panel = document.querySelector<HTMLElement>("[data-mobile-nav]");
  if (toggle && panel) {
    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute(
        "aria-label",
        (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? "",
      );
      toggle.classList.toggle("is-open", open);
      document.body.style.overflow = open ? "hidden" : "";
    };
    toggle.addEventListener("click", () =>
      setOpen(toggle.getAttribute("aria-expanded") !== "true"),
    );
    panel.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) setOpen(false);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
        setOpen(false);
        toggle.focus();
      }
    });
    // If resized up to desktop while open, reset to a clean state. Must match the
    // 1340px hamburger breakpoint in the styles below.
    const mq = window.matchMedia("(min-width: 1341px)");
    mq.addEventListener("change", (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>

<style>
  /* Sticky glass header — high-opacity white blur, hairline base (DESIGN-SYSTEM §6 Nav).
     Every page but the home page; see the html.nr-home block further down for that one. */
  .site-header {
    position: sticky; top: 0; z-index: 60;
    /* 0.82 let high-contrast content read straight through the bar. Worst at the
       bottom of every page, where the footer's large white NOVO wordmark sat
       directly under the header and ghosted into a DOUBLED logo, with the bar
       itself going grey instead of cream over the black footer. 14px of blur
       softens a photograph but cannot hide a 46px wordmark. 0.94 keeps the
       frosted-glass read over imagery while stopping anything behind it from
       being legible. */
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(14px) saturate(1.3);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    border-bottom: 1px solid var(--hairline);
    transition: background-color 0.6s var(--ease), color 0.6s var(--ease), transform 0.7s var(--ease), border-color 0.6s var(--ease);
  }
  /* Full-width bar (2026-09-30): the logo and BOKA sit at the viewport's edges rather than
     the 1200px column's, which is what gives nine one-line tabs room between them. */
  .header-inner {
    display: flex; align-items: center; justify-content: space-between; height: 74px; gap: 1.5rem;
    max-width: none; padding-inline: clamp(20px, 3.2vw, 56px);
  }
  .logo { display: inline-flex; align-items: center; min-height: 44px; }
  /* One line per tab since 2026-09-30 (`nowrap`), replacing the two-line balanced labels
     of the BUTIK round: with the full-width bar and the hamburger taking over at 1340px,
     every label fits on one line in both locales. The gap scales with the viewport. */
  .nav-desktop ul { display: flex; align-items: center; gap: clamp(14px, 1.45vw, 26px); list-style: none; }
  .nav-desktop a {
    position: relative; display: block; white-space: nowrap; line-height: 1.3;
    font-size: 12px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--on-variant); transition: color 0.4s var(--ease);
  }
  /* The underline draws in from the left and retracts to the right, in the link's own
     colour, so it reads over the transparent home header as well as the glass one. */
  .nav-desktop a::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: -6px; height: 1px;
    background: currentColor; transform: scaleX(0); transform-origin: right;
    transition: transform 0.55s var(--ease);
  }
  .nav-desktop a:hover, .nav-desktop a[aria-current="page"] { color: var(--ink); }
  .nav-desktop a:hover::after, .nav-desktop a[aria-current="page"]::after { transform: scaleX(1); transform-origin: left; }
  .header-right { display: flex; align-items: center; gap: clamp(14px, 1.4vw, 24px); }
  .header-right > :global(.btn) { height: 42px; padding: 0 22px; align-self: center; white-space: nowrap; }
  .lang {
    display: inline-flex; align-items: center; gap: 7px;
    font-size: 11px; font-weight: 600; letter-spacing: 0.1em; color: var(--on-variant);
    min-height: 44px;
  }
  .lang-current { color: var(--ink); }
  .lang-sep { color: var(--hairline); font-weight: 400; }
  .lang-other { color: var(--on-variant); transition: color 0.3s; }
  .lang:hover .lang-other { color: var(--ink); }

  /* ── Home page only (2026-09-30) — REVERSES the sticky glass header on this one page.
     refresh.ts adds html.nr-home when the page has a .hero, so without JS the home page
     keeps the sticky glass bar above. The header is fixed over the hero plate: transparent
     with cream type and an inverted logo, then glass once the hero has scrolled past
     (.nr-solid), tucked away while reading down (.nr-hide), and solid cream while the
     menu is open (.nr-open). The glass state is the same 0.94 bar as every other page —
     the kit's 0.82 is the doubled-logo failure documented above. */
  :global(html.nr-home) .site-header {
    position: fixed; inset: 0 0 auto 0;
    background-color: transparent; border-bottom-color: transparent;
    backdrop-filter: none; -webkit-backdrop-filter: none;
  }
  :global(html.nr-home) .site-header:not(.nr-solid) { color: var(--cream); }
  :global(html.nr-home) .site-header:not(.nr-solid) .nav-desktop a,
  :global(html.nr-home) .site-header:not(.nr-solid) .lang,
  :global(html.nr-home) .site-header:not(.nr-solid) .lang-other { color: rgba(248, 248, 248, 0.78); }
  :global(html.nr-home) .site-header:not(.nr-solid) .nav-desktop a:hover,
  :global(html.nr-home) .site-header:not(.nr-solid) .lang-current,
  :global(html.nr-home) .site-header:not(.nr-solid) .lang:hover .lang-other,
  :global(html.nr-home) .site-header:not(.nr-solid) .nav-toggle { color: #fff; }
  :global(html.nr-home) .site-header:not(.nr-solid) .logo :global(svg) { filter: invert(1); }
  :global(html.nr-home) .site-header.nr-solid {
    background-color: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(14px) saturate(1.3);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    border-bottom-color: var(--hairline);
  }
  :global(html.nr-home) .site-header.nr-hide { transform: translateY(-102%); }
  :global(html.nr-home) .site-header.nr-open { transform: none; background-color: var(--cream); }

  /* ── Mobile menu (hamburger + slide-down panel) ─────────────────── */
  .nav-toggle {
    display: none; /* desktop: hidden */
    align-items: center; justify-content: center;
    width: 44px; height: 44px; padding: 0; margin-right: -8px;
    background: transparent; border: 0; cursor: pointer; color: var(--ink);
  }
  .nav-toggle-bars { display: inline-flex; flex-direction: column; gap: 5px; width: 24px; }
  .nav-toggle-bars > span {
    display: block; height: 1.5px; width: 100%; background: currentColor;
    transition: transform 0.3s ease, opacity 0.2s ease;
  }
  .nav-toggle.is-open .nav-toggle-bars > span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
  .nav-toggle.is-open .nav-toggle-bars > span:nth-child(2) { opacity: 0; }
  .nav-toggle.is-open .nav-toggle-bars > span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

  .nav-mobile {
    border-top: 1px solid var(--hairline);
    background: rgba(255, 255, 255, 0.97);
    backdrop-filter: blur(14px) saturate(1.3);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
  }
  .nav-mobile[hidden] { display: none; }
  .nav-mobile ul { list-style: none; padding: 8px var(--gutter, 1.5rem) 4px; }
  .nav-mobile li { border-bottom: 1px solid var(--hairline); }
  .nav-mobile li:last-child { border-bottom: 0; }
  .nav-mobile a {
    display: block; padding: 16px 2px;
    font-size: 15px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--ink);
  }
  .nav-mobile a[aria-current="page"] { color: var(--bronze-dark); }
  .nav-mobile-foot {
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    padding: 18px var(--gutter, 1.5rem) 24px; border-top: 1px solid var(--hairline);
  }

  /* Nine one-line tabs need the full bar, so the hamburger takes over at 1340px and below
     (was 1180px, 2026-09-30, when the tabs still wrapped onto two lines; 820px before that). */
  @media (max-width: 1340px) {
    .nav-desktop { display: none; }
    .nav-toggle { display: inline-flex; }
    /* Top bar on mobile = logo · BOKA (primary CTA stays, per §11) · hamburger.
       The language toggle moves into the panel to keep the bar uncluttered. */
    .header-right > .lang { display: none; }
  }
  @media (min-width: 1341px) {
    .nav-mobile { display: none; }
  }
</style>
