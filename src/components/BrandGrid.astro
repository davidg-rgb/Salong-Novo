---
/**
 * The product lines the salon carries (`/varumarken`, `/en/brands`).
 *
 * Built to be COMPLETE WITHOUT THE ASSETS. The client asked for logos on all
 * five brands (round 3, 2026-08-27) and not one logo file exists yet, so a card
 * with no logo sets the brand name as a serif wordmark and reads as a finished
 * card rather than a broken one. When a logo is uploaded in the admin it takes
 * the wordmark's place and the name goes to the accessibility tree (the logo's
 * `alt`) plus a visually-hidden heading, so the page keeps its outline and
 * stops printing the same word twice.
 *
 * Rows come through `resolveCollection` exactly as the staff grid's do: JSON
 * defaults until the client edits the list, D1 from her first save onward.
 */
import { type Locale, useT } from "../i18n";
import { asBrand, assetUrl, brandDesc } from "../lib/content";
import { resolveCollection } from "../lib/collections";
import { bindings } from "../lib/cms/bindings";
import { BRANDS } from "../cms.config";
const { locale } = Astro.props as { locale: Locale };
const t = useT(locale, (await Astro.locals.getCms()).kv);
const brands = (await resolveCollection(Astro.locals.db, BRANDS)).items.map(asBrand);
const imageBase = (await bindings()).PUBLIC_IMAGE_BASE ?? "";
---
<ul class="brand-grid" role="list">
  {brands.map((brand) => {
    const logo = assetUrl(brand.logo, imageBase);
    const shot = assetUrl(brand.product, imageBase);
    const desc = brandDesc(brand, locale);
    return (
      <li class="brand">
        {shot && (
          <span class="shot" aria-hidden="true">
            <img src={shot} alt="" loading="lazy" decoding="async" />
          </span>
        )}
        <div class="body">
          {logo
            ? <img class="logo" src={logo} alt={brand.name} loading="lazy" decoding="async" />
            : null}
          <h2 class:list={["name", logo && "sr-only"]}>{brand.name}</h2>
          {desc && <p class="desc">{desc}</p>}
          {brand.url && (
            <a class="site" href={brand.url} target="_blank" rel="noopener">
              {t("cta.readMore")} <span class="arr">→</span>
            </a>
          )}
        </div>
      </li>
    );
  })}
</ul>

<style>
  /* Two columns at the article's own measure. A logo wall is not prose and does
     not want a 62ch column, so above 1248px — the first width where the site's
     1152px content box fits with the scrollbar — the grid breaks out of
     `.article`'s 820px cap to full content width and takes a third column. The
     50%/-50% pair is measured against the article's centred content box, which
     is the page's centre, so the result lines up with every other `.wrap`. */
  .brand-grid { list-style: none; display: grid; grid-template-columns: repeat(2, 1fr); gap: clamp(16px, 2vw, 26px); }
  @media (min-width: 1248px) {
    .brand-grid {
      grid-template-columns: repeat(3, 1fr);
      width: 1152px; margin-left: 50%; transform: translateX(-50%);
    }
  }
  .brand {
    display: flex; flex-direction: column;
    border: 1px solid var(--hairline); background: var(--white);
  }
  /* Product shot, when there is one. 4/3 so a bottle sits taller than a card of
     pure type but never dominates the row. */
  .shot { display: block; aspect-ratio: 4/3; background: var(--clay); overflow: hidden; }
  .shot img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .body { padding: clamp(22px, 2.6vw, 32px); display: flex; flex-direction: column; flex: 1; }
  /* Height, not width: logos of different proportions have to look like one
     row, and the only shared dimension a wordmark and a roundel have is height.
     The shipped files are pre-normalized onto a shared 3:1 transparent canvas
     (540x180, mark left-aligned, per-mark optical sizing — a square lockup gets
     full canvas height, a thin wordmark ~62%), so ONE height here yields equal
     visual weight with no JS and no layout shift. A future admin-uploaded logo
     without that treatment still renders — just at this literal height. */
  .logo { height: 45px; width: auto; max-width: 100%; object-fit: contain; object-position: left center; align-self: flex-start; }
  .name { font-family: var(--font-serif); font-weight: 400; font-size: clamp(21px, 2.2vw, 27px); line-height: 1.15; color: var(--ink); }
  /* The logo carries the name once it exists (its `alt`), so the heading stays
     in the outline and leaves the layout. */
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
  .desc { color: var(--on-variant); font-size: 14.5px; line-height: 1.65; margin-top: 12px; max-width: 34ch; }
  .site {
    margin-top: auto; padding-top: 18px;
    font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--bronze-dark);
    display: inline-flex; align-items: center; gap: 8px; align-self: flex-start;
  }
  @media (max-width: 820px) { .site { min-height: 44px; align-items: center; } }
  .site .arr { transition: transform 0.35s; }
  .site:hover .arr { transform: translateX(5px); }
  @media (max-width: 560px) { .brand-grid { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { .site .arr { transition: none; } }
</style>
