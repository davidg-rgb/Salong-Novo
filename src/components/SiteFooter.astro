---
import { type Locale, useT, localizePath } from "../i18n";
import { getSite } from "../lib/content";
import BookingButton from "./BookingButton.astro";
import Logo from "./Logo.astro";
const { locale } = Astro.props as { locale: Locale };
const { kv } = await Astro.locals.getCms();
const t = useT(locale, kv);
const site = getSite(kv);
---
<!-- Champagne closing band — the live-site "warm band" above the black recognition bar
     (DESIGN-SYSTEM §128). Tonal descent: cream page → champagne band → black footer.
     With JS, refresh.ts sets the heading's last word in italic (.nr-em) and reveals the
     words as the band scrolls in; the text itself is exactly what renders here. -->
<section class="footer-cta">
  <div class="wrap fc-inner">
    <p class="fc-eyebrow">{t("closing.eyebrow")}</p>
    <h2 class="fc-head">{t("closing.heading")}</h2>
    <BookingButton locale={locale} />
  </div>
</section>

<footer class="site-footer">
  <div class="wrap">
    <div class="foot">
      <div class="brand">
        <Logo tone="white" height="46px" class="wm" />
        <p>{site.address.street}<br />{site.address.postal} {site.address.city}</p>
        <p class="muted">T-bana {site.transit.metro}</p>
      </div>
      <div>
        <h2 class="fh">{t("labels.address")}</h2>
        <p><a href={`tel:${site.contact.phone.replace(/\s/g, "")}`}>{site.contact.phone_display}</a></p>
        <p><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></p>
        <p><a href={site.contact.instagram} target="_blank" rel="noopener">{site.contact.instagram_handle}</a></p>
        <p class="book"><BookingButton locale={locale} /></p>
      </div>
      {/* Client round 3 (2026-08-27): the salon keeps no fixed hours — they vary
          per stylist — so the two invented time rows are gone and the column is
          the explanation itself. `.hours-note` widens this one column: the same
          11px muted line at the width of an address block would set eight
          two-word lines. */}
      <div>
        <h2 class="fh">{t("labels.hours")}</h2>
        <p class="muted hours-note">{t("footer.openingNote")}</p>
      </div>
    </div>
    <nav class="foot-nav" aria-label={t("labels.menu")}>
      <a href={localizePath("blog", locale)}>{t("nav.blog")}</a>
      <a href={localizePath("about", locale)}>{t("nav.about")}</a>
      <a href={localizePath("privacy", locale)}>{t("footer.privacy")}</a>
    </nav>
    <div class="legal">
      <span>© 2026 Salong NOVO</span>
      <span class="issue">N° 01 — MMXXVI</span>
    </div>
  </div>
</footer>

<style>
  /* Champagne closing band — warm beige bar bridging the light page and the black footer.
     Taller since 2026-09-30, with a faint texture behind it (below). `isolation` keeps
     the texture's z-index: -1 inside the band. */
  .footer-cta {
    position: relative; overflow: hidden; isolation: isolate;
    background: var(--champagne);
    border-top: 1px solid rgba(0, 0, 0, 0.08);
    padding: clamp(96px, 13vw, 180px) 0;
    text-align: center;
  }
  /* PARTLY REVERSES the removal of 2026-08-25 (Home.astro's closing note): that note
     dropped a full-bleed second copy of hair-band.jpg because it read as a repeat of the
     hero. At 10% opacity, desaturated and multiplied into the champagne it is a grain on
     the band, not a photograph (2026-09-30). inset -10% keeps the cover crop's edge out
     of view. */
  .footer-cta::before {
    content: ""; position: absolute; inset: -10%; z-index: -1; pointer-events: none;
    background: url("/images/textures/hair-band.jpg") center / cover no-repeat;
    /* WebP first (2026-10-11); a browser without image-set type() drops this line and
       keeps the JPEG above. Full-width 1536 variant: the band is viewport-wide. */
    background-image: image-set(url("/images/textures/hair-band-1536.webp") type("image/webp"), url("/images/textures/hair-band.jpg") type("image/jpeg"));
    filter: grayscale(1) contrast(1.2); mix-blend-mode: multiply; opacity: 0.1;
  }
  .fc-inner { display: flex; flex-direction: column; align-items: center; gap: 22px; }
  /* Full ink since 2026-09-30 (was 80%), a touch wider tracked. */
  .fc-eyebrow {
    font-family: var(--font-sans); font-size: 11px; font-weight: 600;
    letter-spacing: 0.26em; text-transform: uppercase; color: var(--ink);
  }
  /* `text-wrap: balance` because this line ends in a hyphenated compound: on a
     phone "Redo för din NOVO-stund?" broke after the hyphen and left "stund?"
     orphaned on a line of its own. Balanced, it splits before NOVO instead. The
     band is on every page, so the orphan was too. Display size since 2026-09-30. */
  .fc-head {
    font-weight: 400; color: var(--ink); max-width: 18ch; margin: 0 0 clamp(28px, 3vw, 44px);
    font-size: clamp(52px, 7vw, 112px); line-height: 0.98; letter-spacing: -0.025em; text-wrap: balance;
  }
  /* Ink, not bronze (2026-09-30): the terracotta fill sits at about 2.4:1 against the
     champagne band (computed from the two tokens), under the 3:1 a control's edge needs.
     Ink on champagne is unmistakable, and the hover still lands on the deep bronze. The
     border follows the fill so no bronze rim is left. */
  .footer-cta :global(.btn) {
    margin-top: 6px; height: 56px; padding: 0 36px; white-space: nowrap;
    background: var(--ink); border-color: var(--ink); color: var(--cream);
  }
  .footer-cta :global(.btn:hover) { background: var(--terracotta-deep); border-color: var(--terracotta-deep); }
  /* In motion mode the button is also a scroll reveal (.nr-r, refresh.ts); motion.css's
     reveal `transition` would otherwise replace the hover fade. */
  :global(html.nr-motion) .footer-cta :global(.btn.nr-r) {
    transition:
      opacity 1.1s var(--ease) var(--d, 0ms), transform 1.3s var(--ease) var(--d, 0ms),
      background-color 0.3s, border-color 0.3s;
  }

  /* Recognition bar — black base + terracotta BOKA (DESIGN-SYSTEM §6); the champagne band above
     now carries the warm-band signature, so the black bar drops its old 4px top line. */
  /* Ink footer over the generated silk texture (public/images/textures/, approved 2026-08-12).
     The 0.9 ink overlay keeps text contrast effectively unchanged — the silk reads as a
     low-key sheen, not an image. Solid var(--black) stays the paint-order fallback. */
  .site-footer {
    background:
      linear-gradient(rgba(10, 10, 10, 0.9), rgba(10, 10, 10, 0.9)),
      url("/images/textures/silk-band.jpg") center / cover no-repeat,
      var(--black);
    /* WebP first (2026-10-11), same layers; without image-set type() the line is
       dropped and the shorthand above stands. */
    background-image:
      linear-gradient(rgba(10, 10, 10, 0.9), rgba(10, 10, 10, 0.9)),
      image-set(url("/images/textures/silk-band-1536.webp") type("image/webp"), url("/images/textures/silk-band.jpg") type("image/jpeg"));
    color: var(--cream);
    padding: clamp(64px, 8vw, 100px) 0 0;
  }
  .foot {
    display: grid; grid-template-columns: 1.3fr 0.9fr 1.5fr; gap: 40px;
    padding-bottom: 60px; border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }
  .brand .wm { display: inline-flex; }
  .foot .fh {
    font-family: var(--font-sans); font-size: 10.5px; font-weight: 600;
    letter-spacing: 0.2em; text-transform: uppercase; color: var(--champagne);
    margin-bottom: 20px;
  }
  .foot p { margin-bottom: 11px; }
  .brand p:first-of-type { margin-top: 22px; }
  .foot p, .foot a { color: #cfc8bd; font-size: 14px; line-height: 1.6; transition: color 0.3s; }
  .foot a:hover { color: #fff; }
  /* Footer links draw an underline in from the left on hover (2026-09-30). Scoped to this
     component's own anchors, so the BOKA button in the contact column (BookingButton's
     element) keeps its fill — a `background` shorthand here would have wiped it. */
  .foot a, .foot-nav a {
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: background-size 0.5s var(--ease), color 0.4s;
  }
  .foot a:hover, .foot-nav a:hover { background-size: 100% 1px; }
  /* Touch targets. The <a> is inline by default, so vertical padding does not
     grow its hit box — inline-block is what makes the 44px real. */
  @media (max-width: 820px) {
    .foot p a, .foot-nav a {
      display: inline-block; min-height: 44px; line-height: 44px;
    }
    .foot p { margin-bottom: 0; }
    .foot-nav { gap: 0 28px; }
  }
  .muted { color: #a9a298; }
  /* The Öppettider column is a paragraph now, not two time rows: it takes the
     widest track and a shorter measure so it sets as prose rather than as a
     ladder of two-word lines. */
  .hours-note { max-width: 40ch; line-height: 1.7; }
  .book { margin-top: 8px; }
  /* Footer nav — blog + about (not in primary nav) + privacy. */
  .foot-nav {
    display: flex; flex-wrap: wrap; gap: 14px 28px; align-items: center;
    padding: 24px 0 4px;
    font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase;
  }
  .foot-nav a { color: #cfc8bd; }
  .foot-nav a:hover { color: var(--champagne); }
  .legal {
    display: flex; flex-wrap: wrap; gap: 14px 28px; justify-content: space-between; align-items: center;
    padding: 12px 0 28px; font-size: 12px; letter-spacing: 0.08em; color: #8a8478;
  }
  .legal .issue { font-family: var(--font-serif); letter-spacing: 0.2em; }
  @media (max-width: 820px) { .foot { grid-template-columns: 1fr; gap: 32px; } }
</style>
