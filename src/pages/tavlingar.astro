---
import Base from "../layouts/Base.astro";
import ArticlePage from "../components/ArticlePage.astro";
import { competitions } from "../lib/pagecopy";
import { t } from "../i18n";
const locale = "sv" as const;
---
<Base locale={locale} pageKey="competitions" title={`${t(locale, "nav.competitions")} — Salong NOVO`} description={competitions.intro[locale]}>
  <ArticlePage locale={locale} no="04" kicker={t(locale, "nav.competitions")} heading={competitions.heading[locale]} paragraphs={[competitions.intro[locale]]} />
</Base>
