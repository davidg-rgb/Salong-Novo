---
export const prerender = false;
import Base from "../../layouts/Base.astro";
import Home from "../../components/Home.astro";
import { useT } from "../../i18n";
const locale = "en" as const;
const t = useT(locale, (await Astro.locals.getCms()).kv);
---
<Base locale={locale} pageKey="home" title={t("home.metaTitle")} description={t("home.sub")}>
  <Home locale={locale} />
</Base>
