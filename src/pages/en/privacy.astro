---
export const prerender = false;
import Base from "../../layouts/Base.astro";
import ArticlePage from "../../components/ArticlePage.astro";
import { useT } from "../../i18n";
import { paraKeys } from "../../lib/pagecopy";
const locale = "en" as const;
const t = useT(locale, (await Astro.locals.getCms()).kv);
---
<Base locale={locale} pageKey="privacy" title={`${t("footer.privacy")} — Salong NOVO`} description={t("privacy.metaDescription")}>
  <ArticlePage locale={locale} no="10" kicker={t("footer.privacy")} heading={t("footer.privacy")} paragraphs={paraKeys("privacy", "body").map((key) => t(key))} />
</Base>
