---
export const prerender = false;
import Base from "../../layouts/Base.astro";
import ArticlePage from "../../components/ArticlePage.astro";
import { useT } from "../../i18n";
import { paraKeys } from "../../lib/pagecopy";
const locale = "en" as const;
const t = useT(locale, (await Astro.locals.getCms()).kv);
const body = paraKeys("pricing", "body").map((key) => t(key));
---
<Base locale={locale} pageKey="pricing" title={`${t("nav.pricing")} — Salong NOVO`} description={t("pricing.body1")}>
  <ArticlePage locale={locale} no="03" kicker={t("nav.pricing")} heading={t("pricing.heading")} paragraphs={body} />
</Base>
