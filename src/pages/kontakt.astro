---
export const prerender = false;
import Base from "../layouts/Base.astro";
import ContactPage from "../components/ContactPage.astro";
import { useT } from "../i18n";
const locale = "sv" as const;
const t = useT(locale, (await Astro.locals.getCms()).kv);
---
<Base locale={locale} pageKey="contact" title={`${t("nav.contact")} — Salong NOVO`} description={t("contact.metaDescription")}>
  <ContactPage locale={locale} />
</Base>
