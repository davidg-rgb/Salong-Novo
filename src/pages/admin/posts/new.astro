---
/**
 * Editor — CREATE mode (§10.2). Empty draft (`locale:'sv'`, `status:'draft'`).
 * On the first successful save the client redirects to `/admin/posts/{newId}`
 * so subsequent saves become PUTs.
 */
export const prerender = false;
import AdminBase from "../../../layouts/AdminBase.astro";
import PostEditor from "../../../components/admin/PostEditor.astro";
import type { PostDraft } from "../../../lib/editor";
import { ADMIN } from "../../../lib/admin-strings";
import { bindings } from "../../../lib/cms/bindings";
import "../../../styles/admin-blog.css";

const env = await bindings();
const imageBase = env.PUBLIC_IMAGE_BASE ?? "";

const draft: PostDraft = {
  title: "",
  slug: "",
  slugManual: false,
  locale: "sv",
  excerpt: "",
  coverImage: null,
  body: "",
  author: Astro.locals.adminEmail ?? "",
  seoTitle: "",
  seoDesc: "",
  status: "draft",
};
---
<AdminBase title={ADMIN.nav.newPost}>
  <PostEditor draft={draft} mode="create" imageBase={imageBase} />
</AdminBase>

<script>
  import "../../../admin/editor.client.ts";
</script>
