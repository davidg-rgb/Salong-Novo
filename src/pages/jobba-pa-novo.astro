---
export const prerender = false;
import Base from "../layouts/Base.astro";
import ArticlePage from "../components/ArticlePage.astro";
import { useT } from "../i18n";
import { paraKeys } from "../lib/pagecopy";
const locale = "sv" as const;
const t = useT(locale, (await Astro.locals.getCms()).kv);
---
<Base locale={locale} pageKey="work" title={`${t("nav.work")} — Salong NOVO`} description={t("work.body1")}>
  <ArticlePage locale={locale} no="07" kicker={t("nav.work")} heading={t("work.heading")} paragraphs={paraKeys("work", "body").map((key) => t(key))} />
</Base>
