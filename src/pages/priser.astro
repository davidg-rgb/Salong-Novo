---
export const prerender = false;
import Base from "../layouts/Base.astro";
import ArticlePage from "../components/ArticlePage.astro";
import { useT } from "../i18n";
const locale = "sv" as const;
const t = useT(locale, (await Astro.locals.getCms()).kv);
---
<Base locale={locale} pageKey="pricing" title={`${t("nav.pricing")} — Salong NOVO`} description={t("pricing.note")}>
  <ArticlePage locale={locale} no="03" kicker={t("nav.pricing")} heading={t("pricing.heading")} paragraphs={[t("pricing.note")]} />
</Base>
