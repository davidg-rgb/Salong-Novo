---
export const prerender = false;
import Base from "../layouts/Base.astro";
import StaffPage from "../components/StaffPage.astro";
import { useT } from "../i18n";
const locale = "sv" as const;
const t = useT(locale, (await Astro.locals.getCms()).kv);
---
<Base locale={locale} pageKey="staff" title={`${t("nav.staff")} — Salong NOVO`} description={t("staff.metaDescription")}>
  <StaffPage locale={locale} />
</Base>
