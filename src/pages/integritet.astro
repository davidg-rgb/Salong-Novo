---
import Base from "../layouts/Base.astro";
import ArticlePage from "../components/ArticlePage.astro";
import { t } from "../i18n";
const locale = "sv" as const;
const paras = [
  "Denna sida beskriver hur Salong NOVO behandlar personuppgifter. Fullständig integritetspolicy publiceras inför lansering.",
  "Vi samlar endast in de uppgifter som behövs för att besvara förfrågningar och förbättra webbplatsen. Bokning hanteras av Voady enligt deras villkor.",
];
---
<Base locale={locale} pageKey="privacy" title="Integritetspolicy — Salong NOVO" description="Så hanterar Salong NOVO personuppgifter.">
  <ArticlePage locale={locale} heading={t(locale, "footer.privacy")} paragraphs={paras} />
</Base>
