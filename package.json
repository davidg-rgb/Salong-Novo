{
  "name": "salong-novo-v2",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Salong NOVO — booking-focused fashion-magazine brochure site (Astro + Cloudflare).",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev --config dist/server/wrangler.json --persist-to .wrangler/state",
    "astro": "astro",
    "typecheck": "tsc --noEmit",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply novo_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply novo_db --remote",
    "bildbank:seed:local": "node scripts/bildbank-seed.mjs --local",
    "bildbank:seed:remote": "node scripts/bildbank-seed.mjs --remote",
    "keune:check": "node scripts/keune-sync.mjs --check",
    "keune:update": "node scripts/keune-sync.mjs --update",
    "keune:images": "node scripts/keune-sync.mjs --images"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.7",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/markdown": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "astro": "^7.1.6",
    "lenis": "1.3.26",
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260730.1",
    "@playwright/test": "1.63.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.1.2",
    "happy-dom": "20.14.6",
    "typescript": "^5.7.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  }
}
