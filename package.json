{
  "name": "salong-novo-v2",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Salong NOVO — booking-focused fashion-magazine brochure site (Astro + Cloudflare).",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev --config dist/server/wrangler.json --persist-to .wrangler/state",
    "astro": "astro",
    "typecheck": "tsc --noEmit",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply novo_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply novo_db --remote"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.7",
    "astro": "^7.1.6",
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260730.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.1.2",
    "typescript": "^5.7.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  }
}
